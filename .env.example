# RIFT no-login presentation deployment. Use only for a closed/demo environment.
ENVIRONMENT=development
SERVE_FRONTEND=true
RIFT_DB_PATH=../data/rift.db
DATABASE_URL=

RIFT_AUTH_REQUIRED=false
RIFT_AUTH_SECRET=
RIFT_AUTH_TOKEN_TTL_HOURS=24
RIFT_ALLOW_SIGNUP=false

RIFT_RATE_LIMIT_REDIS_URL=
RIFT_ADAPTER_ALLOWED_HOSTS=
RIFT_ALLOW_LOCAL_ADAPTERS=true
RIFT_PUBLIC_API_BASE_URL=
RIFT_ADAPTER_EVENT_SECRET=

BIFROST_BASE_URL=https://your-bifrost-host/v1
BIFROST_API_KEY=
BIFROST_MODEL=your-real-model-alias
RIFT_EVALUATOR_MODEL=your-evaluator-model-alias

TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=
JUDGE0_LANGUAGE_ID=113
JUDGE0_TIMEOUT_SECONDS=25

MODEL_INPUT_COST_PER_1M=
MODEL_OUTPUT_COST_PER_1M=
TAVILY_COST_PER_SEARCH=

RIFT_PROVIDER_FAULT_PROXY_ENABLED=false
RIFT_PROXY_TOKEN=
UPSTREAM_OPENAI_BASE_URL=https://api.openai.com/v1
UPSTREAM_OPENAI_API_KEY=
CORS_ORIGINS=
RIFT_MCP_MONITOR_INTERVAL_SECONDS=0
