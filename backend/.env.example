# Neon PostgreSQL (recommended): paste the pooled connection string from Neon Console.
# Leave empty to use local SQLite for offline development.
DATABASE_URL=
# Set these to enable real model and web research calls. Leave keys blank until configured.
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=
BIFROST_MODEL=general
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Optional accurate cost estimates. Leave blank to show cost as unavailable.
MODEL_INPUT_COST_PER_1M=
MODEL_OUTPUT_COST_PER_1M=

# Optional upstream provider fault proxy for true Bifrost upstream failure tests. Keep disabled until configured.
# Configure a Bifrost custom OpenAI provider to use your publicly reachable RIFT API URL plus /fault-proxy/v1; protect it with RIFT_PROXY_TOKEN.
RIFT_PROVIDER_FAULT_PROXY_ENABLED=false
RIFT_PROXY_TOKEN=
UPSTREAM_OPENAI_BASE_URL=https://api.openai.com/v1
UPSTREAM_OPENAI_API_KEY=

# Local storage
RIFT_DB_PATH=../data/rift.db
# Optional price per Tavily search request, in USD.
TAVILY_COST_PER_SEARCH=

# Render native deployment: false when React is deployed as a separate Static Site.
SERVE_FRONTEND=true
# Optional extra exact frontend origins (comma-separated). The production
# frontend https://riftz.vercel.app and localhost dev origins are built in.
CORS_ORIGINS=
