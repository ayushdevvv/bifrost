# Runtime
ENVIRONMENT=development
SERVE_FRONTEND=true
RIFT_DB_PATH=../data/rift.db
DATABASE_URL=

# Workspace authentication (enabled by default). Production requires a stable secret.
RIFT_AUTH_REQUIRED=true
RIFT_AUTH_SECRET=
RIFT_AUTH_TOKEN_TTL_HOURS=24
RIFT_ALLOW_SIGNUP=true
# Shared Redis sliding-window limiter (required for production multi-worker use)
RIFT_RATE_LIMIT_REDIS_URL=rediss://default:password@host:port

# Remote agent adapter egress. Exact hostnames only; no wildcard entries.
RIFT_ADAPTER_ALLOWED_HOSTS=agent-adapter.example.com
RIFT_ALLOW_LOCAL_ADAPTERS=true

# Bounded, run-scoped live event streaming from external adapters.
RIFT_PUBLIC_API_BASE_URL=
RIFT_ADAPTER_EVENT_SECRET=

# Bifrost model gateway. Configure a separate evaluator model where possible.
BIFROST_BASE_URL=https://your-bifrost-host/v1
BIFROST_API_KEY=
BIFROST_MODEL=general
RIFT_EVALUATOR_MODEL=general

# Tavily for live Research-10 evidence retrieval.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Isolated Python execution for live Coding-10.
# Use a trusted Judge0 CE instance or hosted Judge0-compatible provider.
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=
JUDGE0_LANGUAGE_ID=71
JUDGE0_TIMEOUT_SECONDS=25

# Optional accurate cost estimates. Leave blank to show cost as unknown.
MODEL_INPUT_COST_PER_1M=
MODEL_OUTPUT_COST_PER_1M=
TAVILY_COST_PER_SEARCH=

# Optional Bifrost upstream fault injection. Use a dedicated Bifrost test route,
# a separate healthy fallback, and a strong RIFT_PROXY_TOKEN.
RIFT_PROVIDER_FAULT_PROXY_ENABLED=false
RIFT_PROXY_TOKEN=
UPSTREAM_OPENAI_BASE_URL=https://api.openai.com/v1
UPSTREAM_OPENAI_API_KEY=

# Browser origins: additional exact origins, comma-separated. Do not use '*'.
CORS_ORIGINS=

# Optional MCP manifest rescanning interval. 0 disables the monitor.
RIFT_MCP_MONITOR_INTERVAL_SECONDS=900
